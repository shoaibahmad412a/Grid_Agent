# Copy to .env and fill in. .env is git-ignored; never commit keys.
LLM_API_KEY=
# OpenAI model id (default gpt-5-nano)
LLM_API_MODEL=gpt-5-nano
# Leave empty for https://api.openai.com/v1
LLM_API_BASE=
# Reasoning effort for gpt-5-nano: minimal|low|medium|high (empty = model default). Keep it fixed for all runs.
LLM_API_EFFORT=low
# Empty = auto (temperature 0 + seed only for non-reasoning models; gpt-5-nano accepts neither),
# "0" = always send them, "off" = never send them
LLM_API_TEMPERATURE=
OLLAMA_MODEL=
OLLAMA_URL=http://localhost:11434
CODECARBON_COUNTRY=PAK
