# Copy to .env and fill in. .env is git-ignored; never commit keys.
LLM_API_KEY=
LLM_API_MODEL=
# "openai" = any OpenAI-compatible /chat/completions API (OpenAI, Groq, Together, OpenRouter, DeepSeek...)
# "anthropic" = Anthropic Messages API
LLM_API_PROVIDER=openai
# Base URL of the API; leave empty for the provider default
LLM_API_BASE=
OLLAMA_MODEL=
OLLAMA_URL=http://localhost:11434
CODECARBON_COUNTRY=PAK
