# Copy to .env and fill in. .env is git-ignored; never commit keys.
LLM_API_KEY=
# Exact model id, e.g. gemini-3.1-flash-lite (check the id in Google AI Studio; it may end in -preview)
LLM_API_MODEL=
# "gemini" = Google Gemini API; "anthropic" = Anthropic Messages API;
# "openai" = any OpenAI-compatible /chat/completions API (OpenAI, Groq, Together, OpenRouter, DeepSeek...)
LLM_API_PROVIDER=gemini
# Base URL of the API; leave empty for the provider default
LLM_API_BASE=
# Reasoning effort (empty = model default). Gemini: minimal|low|medium|high. Anthropic: low|medium|high|xhigh|max
LLM_API_EFFORT=
OLLAMA_MODEL=
OLLAMA_URL=http://localhost:11434
CODECARBON_COUNTRY=PAK
